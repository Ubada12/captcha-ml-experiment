# ============================================================
# DEPENDENCIES — platform-specific, never portable between
# machines. Always run a fresh install on whatever machine
# actually runs this rather than trusting a committed copy.
# ============================================================

# Puppeteer's bundled Chromium differs per OS/arch.
node_modules/

# ml-service's Python dependencies — same reasoning, plus a venv
# folder is enormous and machine-specific. Covers every common
# naming convention so a stray `python -m venv foo` still gets caught.
ml-service/venv/
ml-service/.venv/
ml-service/env/
**/__pycache__/
*.pyc
*.pyo

# ============================================================
# SECRETS — never committed, ever. A leaked TWOCAPTCHA_API_KEY,
# API_KEYS list, or GSTIN credential is a real-money/real-access
# leak, not just an inconvenience.
# ============================================================
.env
.env.*
# ...except a template that deliberately holds no real values —
# uncomment/add one if this project ever ships an example file:
!.env.example
*.pem
*.key
*.p12

# ============================================================
# LARGE BINARIES — never belong in git history. A checkpoint
# committed once stays in every future clone forever, even after
# being deleted, because git history doesn't shrink on its own.
# These are synced machine-to-machine directly (see README), not
# version-controlled.
# ============================================================
ml-service/checkpoint/
*.pt
*.pth
*.onnx
*.h5

# ============================================================
# GENERATED AT RUNTIME — reproducible from code + config, and
# some of it (results/, captcha-failures/) can contain real GSTIN
# lookups or CAPTCHA images, which don't belong in version control
# even accidentally.
# ============================================================
logs/
data/
*.log

# ============================================================
# OS / EDITOR CRUFT — machine-and-tool-specific, never part of
# the project itself.
# ============================================================
# macOS
.DS_Store
# Windows
Thumbs.db
Desktop.ini
# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# TEST / COVERAGE / SCRATCH OUTPUT — regenerated by running the
# tests, not something to diff or review in a PR.
# ============================================================
coverage/
.nyc_output/
.pytest_cache/
htmlcov/
*.tmp
.tmp/

# Documentation
docs/

# Markdown files
*.md

# Keep README
!README.md